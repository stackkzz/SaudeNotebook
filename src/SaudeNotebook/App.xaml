<Application x:Class="SaudeNotebook.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2A2F3A"/>
      <Setter Property="Foreground" Value="#E6E8EB"/>
      <Setter Property="BorderBrush" Value="#3A4150"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Claude" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#C96442"/>
      <Setter Property="BorderBrush" Value="#C96442"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Mini" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6E8EB"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#181B21"/>
      <Setter Property="BorderBrush" Value="#262A33"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#E6E8EB"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="tb" Padding="16,8" Margin="0,0,4,0" CornerRadius="6,6,0,0" Background="Transparent">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="tb" Property="Background" Value="#262B35"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tb" Property="Background" Value="#20242C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#1C1F26"/>
      <Setter Property="Foreground" Value="#E6E8EB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="#1C1F26"/>
      <Setter Property="AlternatingRowBackground" Value="#20242C"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="CanUserSortColumns" Value="False"/>
      <Setter Property="MinRowHeight" Value="32"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#262B35"/>
      <Setter Property="Foreground" Value="#AEB4BF"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="8,0" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#2D3B55"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SevTexto" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="Text" Value="Crítico"><Setter Property="Foreground" Value="#FF6B6B"/></Trigger>
        <Trigger Property="Text" Value="Atenção"><Setter Property="Foreground" Value="#F5B942"/></Trigger>
        <Trigger Property="Text" Value="Info"><Setter Property="Foreground" Value="#60A5FA"/></Trigger>
        <Trigger Property="Text" Value="OK"><Setter Property="Foreground" Value="#4ADE80"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Quebra" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,6"/>
    </Style>
    <Style x:Key="AlertaProc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF8A8A"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Cartao" TargetType="Border">
      <Setter Property="Background" Value="#1C1F26"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="BorderBrush" Value="#262A33"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Rotulo" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8B93A1"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Valor" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8B93A1"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="5"/>
      <Setter Property="Background" Value="#2A2F39"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#4ADE80"/>
      <Setter Property="Maximum" Value="100"/>
    </Style>
  </Application.Resources>
</Application>
